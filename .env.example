# ============================================================
# 环境变量模板：复制为 .env 后按实际环境修改
# .env 含敏感信息，已在 .gitignore 中排除，不要提交到版本库
# ============================================================

# ------------------------------------------------------------
# 会话密钥
# 留空即可 —— 系统会自动生成随机密钥并保存到 instance/secret_key，
# 重启后已登录会话不会失效。生产环境也可显式指定一个随机长字符串。
SECRET_KEY=

# ------------------------------------------------------------
# 数据库
# 默认使用项目内的 SQLite 文件，无需额外服务。
# 如需改用 MySQL / PostgreSQL，取消注释并填写连接串（详见 docs/部署说明.md）。
# DATABASE_URL=sqlite:///instance/app.db

# ------------------------------------------------------------
# 大语言模型（说明书 5.2）
# 方式一：在这里填写；方式二：启动后由管理员在【系统管理 → 模型与系统设置】填写
# 未配置 API Key 时系统不会生成任何内容，只给出明确提示
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=90

# ------------------------------------------------------------
# 服务监听
# PORT 留空或为 5000 时按本地开发对待；云端/容器平台会注入 PORT，
# 此时自动监听 0.0.0.0 并强制关闭调试模式，无需在此配置 HOST。
PORT=5000
FLASK_DEBUG=1
# 仅在需要覆盖默认监听地址时才填写（不要写 127.0.0.1，否则云端将无法被访问）
# HOST=0.0.0.0

# 由反向代理（HTTPS）对外提供服务时设为 1，强制 Cookie 仅经 HTTPS 传输
COOKIE_SECURE=0
